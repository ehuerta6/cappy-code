# Local development uses the Firebase Emulator Suite. Set to false only when
# intentionally connecting to a configured real Firebase project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Required only when NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false. These are public
# Firebase Web app values, not authorization credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
