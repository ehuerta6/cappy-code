rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOfficer() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function sessionIsPublic(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data.status
        in ['live', 'ended'];
    }

    function sessionIsEnded(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data.status
        == 'ended';
    }

    function answersAreVisible(sessionId, problemId) {
      return get(
        /databases/$(database)/documents/sessions/$(sessionId)/problems/$(problemId)
      ).data.answersVisible == true;
    }

    function liveSessionPath() {
      return /databases/$(database)/documents/sessionControl/liveSession;
    }

    function liveSessionAfterIs(sessionId) {
      return existsAfter(liveSessionPath())
        && getAfter(liveSessionPath()).data.sessionId == sessionId;
    }

    function liveSessionClearedAfter(sessionId) {
      return !existsAfter(liveSessionPath())
        || getAfter(liveSessionPath()).data.sessionId != sessionId;
    }

    function sessionInactiveAfter(sessionId) {
      return !existsAfter(
          /databases/$(database)/documents/sessions/$(sessionId)
        )
        || getAfter(
          /databases/$(database)/documents/sessions/$(sessionId)
        ).data.status != 'live';
    }

    function hasSupportedBranch(data) {
      return data.keys().hasAny(['branch'])
        && data.branch in ['intro', 'general', 'icpc'];
    }

    function hasSupportedProblemCategory(data) {
      return data.keys().hasAny(['category'])
        && data.category in ['custom', 'interview-style', 'competitive-programming'];
    }

    function validApproachSolution(data) {
      return data.keys().hasAll(['code'])
        && data.keys().hasOnly(['code', 'timeComplexity', 'timeComplexityReason', 'spaceComplexity', 'spaceComplexityReason'])
        && data.code is string
        && (!data.keys().hasAny(['timeComplexity']) || data.timeComplexity is string)
        && (!data.keys().hasAny(['timeComplexityReason']) || data.timeComplexityReason is string)
        && (!data.keys().hasAny(['spaceComplexity']) || data.spaceComplexity is string)
        && (!data.keys().hasAny(['spaceComplexityReason']) || data.spaceComplexityReason is string);
    }

    function changesOnlyProblemContent() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title',
        'description',
        'constraints',
        'exampleInput',
        'exampleOutput',
        'leetcodeUrl',
        'difficulty',
        'category'
      ]);
    }

    function changesOnlyLiveProblemContent() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title',
        'description',
        'constraints',
        'exampleInput',
        'exampleOutput',
        'leetcodeUrl',
        'difficulty',
        'category',
        'answersVisible'
      ]);
    }

    function bankProblemUsedByActiveSession(problemId) {
      return exists(liveSessionPath())
        ? (get(liveSessionPath()).data.get('sessionId', null) is string
            ? activeSessionUsesBankProblem(
                get(liveSessionPath()).data.sessionId,
                problemId
              )
            : false)
        : false;
    }

    function activeSessionUsesBankProblem(sessionId, problemId) {
      return exists(/databases/$(database)/documents/sessions/$(sessionId))
        ? (get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == 'live'
            ? (get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('bankProblemIds', []) is list
                ? get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('bankProblemIds', []).hasAny([problemId])
                : false)
            : false)
        : false;
    }

    function bankProblemDataIsPublished(data) {
      return data.get('isPublished', data.get('isPublic', false)) == true;
    }

    function bankProblemDataIsNotHidden(data) {
      return !data.keys().hasAny(['hiddenByLiveSessionId'])
        || data.hiddenByLiveSessionId == null;
    }

    function bankProblemIsEffectivelyVisible(problemId) {
      return bankProblemDataIsPublished(resource.data)
        && bankProblemDataIsNotHidden(resource.data)
        && !bankProblemUsedByActiveSession(problemId);
    }

    function bankProblemIsListVisible() {
      return bankProblemDataIsPublished(resource.data)
        && bankProblemDataIsNotHidden(resource.data);
    }

    function bankSolutionParentIsEffectivelyVisible(problemId) {
      let bankProblem = get(
        /databases/$(database)/documents/problemBank/$(problemId)
      ).data;
      return bankProblemDataIsPublished(bankProblem)
        && bankProblemDataIsNotHidden(bankProblem)
        && !bankProblemUsedByActiveSession(problemId);
    }

    match /sessions/{sessionId} {
      allow read: if isOfficer() || resource.data.status in ['live', 'ended'];
      allow create: if isOfficer()
        && request.resource.data.status == 'draft'
        && hasSupportedBranch(request.resource.data);
      allow update: if isOfficer()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bankProblemIds'])
          || resource.data.status == 'draft')
        && ((!resource.data.keys().hasAny(['branch'])
            && !request.resource.data.keys().hasAny(['branch']))
          || hasSupportedBranch(request.resource.data))
        && (request.resource.data.status == resource.data.status
          || (resource.data.status == 'draft'
            && request.resource.data.status == 'live'
            && liveSessionAfterIs(sessionId))
          || (resource.data.status == 'live'
            && request.resource.data.status in ['draft', 'ended']
            && liveSessionClearedAfter(sessionId)));
      allow delete: if isOfficer()
        && (resource.data.status != 'live'
          || liveSessionClearedAfter(sessionId));

      match /problems/{problemId} {
        allow read: if isOfficer() || sessionIsPublic(sessionId);
        allow create: if isOfficer()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == 'draft';
        allow update: if isOfficer()
          && (get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == 'draft'
            || (get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == 'live'
              && changesOnlyLiveProblemContent())
            || (get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == 'ended'
              && changesOnlyProblemContent()));
        allow delete: if isOfficer()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == 'draft';

        match /solutions/{language} {
          allow read: if (isOfficer() && language in ['python', 'java', 'cpp']) ||
            (language in ['python', 'java', 'cpp'] &&
             sessionIsPublic(sessionId) &&
             (sessionIsEnded(sessionId) ||
              answersAreVisible(sessionId, problemId)));
          allow write: if isOfficer() && language in ['python', 'java', 'cpp'];
        }

        match /approaches/{approachId} {
          function sessionState() { return get(/databases/$(database)/documents/sessions/$(sessionId)).data.status; }
          allow read: if isOfficer() || (sessionIsPublic(sessionId) &&
            (sessionIsEnded(sessionId) || answersAreVisible(sessionId, problemId)));
          allow create: if isOfficer() && sessionState() == 'draft'
            && request.resource.data.keys().hasAll(['name', 'tags', 'order']) && request.resource.data.keys().hasOnly(['name', 'tags', 'order'])
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.tags is list
            && request.resource.data.tags.hasOnly(['Arrays', 'Hash Map', 'Two Pointers', 'Binary Search', 'Stack', 'Queue', 'Linked List', 'Tree', 'Graph', 'DFS', 'BFS', 'Dynamic Programming', 'Greedy', 'Backtracking', 'Union Find', 'Shortest Path'])
            && request.resource.data.order is int && request.resource.data.order >= 0;
          allow delete: if isOfficer() && sessionState() == 'draft';
          allow update: if isOfficer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'tags', 'order'])
            && request.resource.data.keys().hasAll(['name', 'tags', 'order']) && request.resource.data.keys().hasOnly(['name', 'tags', 'order'])
            && request.resource.data.name is string && request.resource.data.name.size() > 0
            && request.resource.data.tags is list && request.resource.data.tags.hasOnly(['Arrays', 'Hash Map', 'Two Pointers', 'Binary Search', 'Stack', 'Queue', 'Linked List', 'Tree', 'Graph', 'DFS', 'BFS', 'Dynamic Programming', 'Greedy', 'Backtracking', 'Union Find', 'Shortest Path'])
            && request.resource.data.order is int && request.resource.data.order >= 0
            && ((sessionState() == 'draft') ||
              (sessionState() in ['live', 'ended'] && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['order'])));
          match /solutions/{language} {
            allow read: if (isOfficer() && language in ['python', 'java', 'cpp']) ||
              (language in ['python', 'java', 'cpp'] && sessionIsPublic(sessionId) &&
                (sessionIsEnded(sessionId) || answersAreVisible(sessionId, problemId)));
            allow create, update: if isOfficer() && language in ['python', 'java', 'cpp'] && validApproachSolution(request.resource.data);
            allow delete: if isOfficer() && language in ['python', 'java', 'cpp'];
          }
        }
      }
    }

    match /sessionControl/liveSession {
      allow read: if isOfficer();
      allow create: if isOfficer()
        && request.resource.data.keys().hasOnly(['sessionId'])
        && request.resource.data.sessionId != null
        && getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'live';
      allow update: if isOfficer()
        && request.resource.data.keys().hasOnly(['sessionId'])
        && (request.resource.data.sessionId == null
          ? (resource.data.sessionId == null
            || sessionInactiveAfter(resource.data.sessionId))
          : getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'live'
            && (resource.data.sessionId == null
              || resource.data.sessionId == request.resource.data.sessionId
              || sessionInactiveAfter(resource.data.sessionId)));
      allow delete: if isOfficer()
        && (resource.data.sessionId == null
          || sessionInactiveAfter(resource.data.sessionId));
    }

    match /problemBank/{problemId} {
      allow get: if isOfficer()
        || bankProblemIsEffectivelyVisible(problemId);
      allow list: if isOfficer() || bankProblemIsListVisible();
      allow create: if isOfficer()
        && hasSupportedProblemCategory(request.resource.data)
        && request.resource.data.isPublished == false
        && request.resource.data.hiddenByLiveSessionId == null;
      allow update: if isOfficer()
        && hasSupportedProblemCategory(request.resource.data)
        && (request.resource.data.isPublished is bool
          || (!request.resource.data.keys().hasAny(['isPublished'])
            && request.resource.data.keys().hasAny(['isPublic'])
            && request.resource.data.isPublic is bool));
      allow delete: if isOfficer();

      match /solutions/{language} {
        allow read: if isOfficer()
          || (language in ['python', 'java', 'cpp']
            && bankSolutionParentIsEffectivelyVisible(problemId));
        allow write: if isOfficer() && language in ['python', 'java', 'cpp'];
      }

      match /approaches/{approachId} {
        allow read: if isOfficer() || bankSolutionParentIsEffectivelyVisible(problemId);
        allow create: if isOfficer() && request.resource.data.keys().hasAll(['name', 'tags', 'order']) && request.resource.data.keys().hasOnly(['name', 'tags', 'order']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.tags is list && request.resource.data.tags.hasOnly(['Arrays', 'Hash Map', 'Two Pointers', 'Binary Search', 'Stack', 'Queue', 'Linked List', 'Tree', 'Graph', 'DFS', 'BFS', 'Dynamic Programming', 'Greedy', 'Backtracking', 'Union Find', 'Shortest Path']) && request.resource.data.order is int && request.resource.data.order >= 0;
        allow update: if isOfficer() && request.resource.data.keys().hasAll(['name', 'tags', 'order']) && request.resource.data.keys().hasOnly(['name', 'tags', 'order']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.tags is list && request.resource.data.tags.hasOnly(['Arrays', 'Hash Map', 'Two Pointers', 'Binary Search', 'Stack', 'Queue', 'Linked List', 'Tree', 'Graph', 'DFS', 'BFS', 'Dynamic Programming', 'Greedy', 'Backtracking', 'Union Find', 'Shortest Path']) && request.resource.data.order is int && request.resource.data.order >= 0;
        allow delete: if isOfficer();
        match /solutions/{language} {
          allow read: if (isOfficer() && language in ['python', 'java', 'cpp']) ||
            (language in ['python', 'java', 'cpp'] && bankSolutionParentIsEffectivelyVisible(problemId));
          allow create, update: if isOfficer() && language in ['python', 'java', 'cpp'] && validApproachSolution(request.resource.data);
          allow delete: if isOfficer() && language in ['python', 'java', 'cpp'];
        }
      }
    }
  }
}
